# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Google Calendar (obtenidos con setup_google_auth.py) ───────────────────────
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...
GOOGLE_REFRESH_TOKEN=...
GOOGLE_CALENDAR_ID=primary          # o el ID del calendario específico

# ── Twilio ─────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...

# ── Opcional ───────────────────────────────────────────────────────────────────
DB_PATH=conversations.db            # ruta al archivo SQLite
VALIDATE_TWILIO_SIGNATURE=false     # cambiar a "true" en producción
