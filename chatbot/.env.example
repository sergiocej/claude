# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Meta / Instagram
PAGE_ACCESS_TOKEN=EAAxxxxxx...

# Meta / WhatsApp Business Cloud API
# Encontralo en: Meta for Developers → tu app → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_ACCESS_TOKEN=EAAxxxxxx...

# Webhook (compartido por Instagram y WhatsApp)
VERIFY_TOKEN=juris_consultas_verify_2024

# Google Calendar (Service Account)
# Pegá el contenido completo del JSON de la cuenta de servicio (en una sola línea)
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"bot-calendar@tu-proyecto.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
# ID del calendario (normalmente tu email de Gmail, o el ID del calendario)
GOOGLE_CALENDAR_ID=tu_email@gmail.com

# Servidor
PORT=3000
